# ==========================================
# PayPilot Environment Configuration
# ==========================================

# ------------------------------------------
# Backend Server Configuration
# ------------------------------------------
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------
# AI Provider (Google Gemini API)
# ------------------------------------------
# Get your free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# PayPal Developer Sandbox
# ------------------------------------------
# Obtain sandbox credentials at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Default checkout currency (USD is universally supported across PayPal Sandbox test accounts)
PAYPAL_CURRENCY=USD

# ------------------------------------------
# Supabase PostgreSQL Database (Optional for local dev, used in production)
# ------------------------------------------
# If left empty, PayPilot will automatically use its built-in persistent local repository
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ------------------------------------------
# Frontend Environment Variables (Prefix with VITE_)
# ------------------------------------------
VITE_API_BASE_URL=http://localhost:5000/api
VITE_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
